# ProBase Production Environment (copy thanh ~/probase/.env tren VPS)

API_IMAGE=<username>/probase-api:latest
API_PORT=3010

POSTGRES_USER=probase
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=probase

FRONTEND_URL=https://your-app.vercel.app
# Optional extra CORS origins (comma-separated, supports * wildcard like https://*.vercel.app)
# CORS_ORIGINS=https://www.your-domain.com,https://*.vercel.app
TRUST_PROXY_HOPS=1
# COOKIE_SECURE=true
# Use "none" when frontend and API are on different root domains (e.g. vercel.app -> custom API domain)
# COOKIE_SAME_SITE=lax

JWT_SECRET=change-this-jwt-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@probase.dev
BREVO_SENDER_NAME=ProBase

SEED_ADMIN_EMAIL=gvgvk@dlu.edu.vn
SEED_ADMIN_PASSWORD=change-this-admin-password
SEED_LECTURER_PASSWORD=change-this-lecturer-password
SEED_GVCN_EMAIL=gvcn@dlu.edu.vn
SEED_GVCN_PASSWORD=change-this-gvcn-password
