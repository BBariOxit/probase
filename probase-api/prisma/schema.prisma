// This is your Prisma schema file
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum Role {
  ADMIN
  LECTURER
  STUDENT
}

// Topic allocation mode for a registration round
enum AllocationMode {
  FIRST_COME
  PREFERENCE_ROUND
}

// Five stages of a registration round
enum RoundPhase {
  PREP        // Lecturers prepare topics; students can browse but not register
  OPEN        // Students register and form groups
  RECONCILING // Registration closed; faculty office manually places unassigned students
  EXTENDED    // Registration reopened one-way for unassigned students
  FINALIZED   // Allocation is settled; project work officially starts
}

// Origin of how a student joined a registration group
enum GroupJoinSource {
  SELF     // Registered or joined topic directly
  LINK     // Joined via group invitation link
  ASSIGNED // Placed by faculty office during reconciliation
}

enum TopicProposalStatus {
  DRAFT
  PENDING
  NEEDS_REVISION
  ACCEPTED
  REJECTED
}

enum AttachmentType {
  DOCUMENT
  IMAGE
}

enum TopicStatus {
  DRAFT              // Lecturer draft, not yet submitted for review
  PENDING            // Pending initial review
  PENDING_DEPARTMENT // Pending department head academic review
  APPROVED_OPEN      // Approved and open for student registration
  APPROVED           // Approved by department
  OPEN               // Open for student registration
  ASSIGNED           // Assigned to a student group
  IN_PROGRESS        // In progress (outline M03 submitted and approved)
  COMPLETED          // Completed defense and archived
  REJECTED           // Rejected
}

enum RegistrationGroupStatus {
  FORMING
  SUBMITTED
  APPROVED
  REJECTED
}

enum GroupMemberStatus {
  INVITED
  ACCEPTED
  DECLINED
}

// Reviewer is assigned per topic via CouncilTopic.reviewerId (single source of truth)
enum CouncilMemberRole {
  PRESIDENT
  SECRETARY
  MEMBER
}

// Notification category for routing and filtering client notifications
enum NotificationType {
  PROPOSAL_SUBMITTED          // Student submitted a proposal to lecturer
  PROPOSAL_REVISION_REQUESTED // Lecturer requested revisions on proposal
  PROPOSAL_RESUBMITTED        // Student resubmitted revised proposal
  PROPOSAL_COMMENTED          // New comment posted on proposal
  PROPOSAL_UPDATED            // Proposal content was updated
  PROPOSAL_ACCEPTED           // Proposal was approved by lecturer
  PROPOSAL_REJECTED           // Proposal was rejected by lecturer

  GROUP_MEMBER_JOINED         // A student joined the group
  GROUP_MEMBER_REMOVED        // A student was removed by the group leader
  GROUP_DISBANDED             // Group was disbanded
  ROUND_EXTENDED              // Registration round was extended
  GROUP_MEMBER_ASSIGNED       // Student was assigned to group by faculty office
  TOPIC_STUDENT_ASSIGNED      // Student was assigned to lecturer's topic by office
  ROUND_FINALIZED             // Registration round was finalized

  SUBMISSION_FEEDBACK         // Feedback received on a submission
  REGISTRATION_CLOSING_SOON   // Registration deadline approaching reminder
  SUBMISSION_DUE_SOON         // Submission deadline approaching reminder
  GRADE_PUBLISHED             // Grades published
  DEADLINE_REMINDER           // General deadline reminder

  OUTLINE_SUBMITTED           // Topic outline (M03) submitted
  OUTLINE_REVISION_REQUESTED  // Revisions requested for outline
  OUTLINE_APPROVED            // Topic outline approved

  STUDENT_ELIGIBILITY_CONFIRMED // Student confirmed eligible for registration round

  PROGRESS_LOG_SUBMITTED      // Weekly progress log submitted
  PROGRESS_LOG_FEEDBACK       // Supervisor gave feedback on weekly log
  PROGRESS_REPORT_SUBMITTED   // Stage progress report submitted
  PROGRESS_REPORT_GRADED      // Stage progress report graded
  REVIEWER_ASSIGNED           // Reviewer assigned to topic
  COUNCIL_SCHEDULED           // Defense council scheduled
  COUNCIL_DEFENSE_COMPLETED   // Defense session completed
}

// ─────────────────────────────────────────────────────────
// GROUP 1: AUTHENTICATION & PROFILES
// ─────────────────────────────────────────────────────────

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  password            String    // Bcrypt hash — never store plaintext
  role                Role
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false) // Force password change on first login
  failedPasswordCount Int       @default(0)     // Account-based brute-force attempt counter
  passwordRetryAfter  DateTime? // Active delay timestamp for rate-limiting
  avatarUrl           String?   // Hosted avatar image URL
  avatarPublicId      String?   // Storage handle for file deletion
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  studentProfile           StudentProfile?
  lecturerProfile          LecturerProfile?
  notifications            Notification[]
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  roundsFinalised          RegistrationRound[]       @relation("RoundFinalisedBy")
  membersAssigned          RegistrationGroupMember[] @relation("GroupMemberAssignedBy")
  topicAssignmentsAssigned TopicAssignment[]         @relation("TopicAssignmentAssignedBy")
  proposalComments         ProposalComment[]
  proposalCommentReactions ProposalCommentReaction[]
  outlinesSubmitted        TopicOutline[]            @relation("OutlineSubmittedBy")
  weeklyLogsSubmitted      WeeklyLog[]               @relation("WeeklyLogSubmittedBy")
  progressReportsSubmitted ProgressReport[]          @relation("ProgressReportSubmittedBy")

  @@map("users")
}

model StudentProfile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  majorId     Int?
  studentCode String  @unique
  fullName    String
  class       String? // e.g. "CTK46PM" — class code
  cohort      String? // e.g. "2021" — intake year
  phone       String?
  bio         String?
  note        String? @db.Text // Administrative note by faculty office

  // Relations
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  major              Major?                    @relation(fields: [majorId], references: [id], onDelete: SetNull)
  proposedTopics     TopicProposal[]           @relation("ProposalStudent")
  groupsLed          RegistrationGroup[]
  groupMemberships   RegistrationGroupMember[]
  councilGrades      CouncilTopicGrade[]
  studentGrades      StudentGrade[]
  submissions        Submission[]              @relation("SubmissionAuthor")
  roundEligibilities RoundStudentEligibility[]

  @@map("student_profiles")
}

model LecturerProfile {
  id                  Int     @id @default(autoincrement())
  userId              Int     @unique
  lecturerCode        String  @unique
  fullName            String
  academicTitle       String?
  majorId             Int?    // Department/Specialization: Software Engineering (CNPM) or Networks (MMT)
  phone               String?
  bio                 String?
  researchInterests   String?
  maxMentoringQuota   Int?    // Maximum groups a lecturer can mentor (null = no limit)
  isHeadOfDepartment  Boolean @default(false) // Department Head role
  isAcademicAssistant Boolean @default(false) // Faculty Academic Assistant role

  // Relations
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  major                    Major?            @relation(fields: [majorId], references: [id], onDelete: SetNull)
  requestedProposals       TopicProposal[]   @relation("ProposalRequestedLecturer")
  acceptedProposals        TopicProposal[]   @relation("ProposalAcceptedLecturer")
  topics                   Topic[]
  departmentReviewedTopics Topic[]           @relation("TopicDepartmentReviewer")
  supervisorAssignments    TopicAssignment[] @relation("TopicAssignmentSupervisor")
  reviewerAssignments      TopicAssignment[] @relation("TopicAssignmentReviewer")
  councilMembers           CouncilMember[]
  reviewedTopics           CouncilTopic[]
  topicReviews             TopicReview[]

  @@map("lecturer_profiles")
}

// ─────────────────────────────────────────────────────────
// GROUP 2: MASTER DATA
// ─────────────────────────────────────────────────────────

// Academic Department / Specialization (e.g. Software Engineering 'CNPM', Computer Networks 'MMT')
model Major {
  id          Int     @id @default(autoincrement())
  name        String
  code        String  @unique // Department code: 'CNPM' | 'MMT'
  description String? @db.Text

  // Relations
  students  StudentProfile[]
  lecturers LecturerProfile[]
  topics    Topic[]
  councils  Council[]

  @@map("majors")
}

model Semester {
  id                      Int       @id @default(autoincrement())
  name                    String
  code                    String    @unique
  startDate               DateTime
  endDate                 DateTime
  gradeSubmissionDeadline DateTime? // Deadline after which grades are locked
  isActive                Boolean   @default(false)
  mentorWeight            Float     @default(0.2) // Progress 1 weight (Supervisor)
  reviewerWeight          Float     @default(0.3) // Progress 2 weight (Supervisor + Reviewer)
  councilWeight           Float     @default(0.5) // Defense council weight
  progress1Weight         Float     @default(0.2) // Progress 1 weight alias
  progress2Weight         Float     @default(0.3) // Progress 2 weight alias
  defenseWeight           Float     @default(0.5) // Defense weight alias

  // Relations
  rounds             RegistrationRound[]
  topics             Topic[]
  topicProposals     TopicProposal[]
  registrationGroups RegistrationGroup[]
  councils           Council[]

  @@map("semesters")
}

/// Registration round: a semester crossed with a specific project type
model RegistrationRound {
  id                         Int            @id @default(autoincrement())
  semesterId                 Int
  projectTypeId              Int
  registrationStart          DateTime       // Registration gate opens
  registrationEnd            DateTime       // Registration gate closes (extension moves this date)
  phase                      RoundPhase     @default(PREP)
  allocationMode             AllocationMode @default(FIRST_COME)
  targetCohort               String?        // Target student cohort/class (e.g. "CTK46", "CTK47")
  officialStartDate          DateTime?      // Official project start date (3-month schedule)
  officialEndDate            DateTime?      // Official project end date
  maxStudentsPerTopic        Int            @default(2) // Maximum students per topic/group for this round
  minTopicsPerLecturer       Int?           // Recommended minimum topics each lecturer should submit
  topicSubmissionStart       DateTime?      // Lecturer topic submission start
  topicSubmissionEnd         DateTime?      // Department head & faculty topic approval deadline
  outlineDeadline            DateTime?      // Detailed outline (M03) submission deadline
  progress1Deadline          DateTime?      // Progress 1 submission and evaluation deadline (20%)
  reviewerAssignmentDeadline DateTime?      // Reviewer assignment deadline
  progress2Deadline          DateTime?      // Progress 2 submission and evaluation deadline (30%)
  finalSubmissionDeadline    DateTime?      // Final report and review (M02/M05) deadline
  defenseStartDate           DateTime?      // Defense council start date (50%)
  defenseEndDate             DateTime?      // Defense council end date
  archiveDeadline            DateTime?      // Digital archive package deadline
  finalisedAt                DateTime?      // Timestamp when reconciliation was finalised
  finalisedById              Int?           // User who finalised the round
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  // Relations
  semester         Semester                  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  projectType      ProjectType               @relation(fields: [projectTypeId], references: [id], onDelete: Restrict)
  finalisedBy      User?                     @relation("RoundFinalisedBy", fields: [finalisedById], references: [id], onDelete: SetNull)
  eligibilities    RoundEligibility[]
  eligibleStudents RoundStudentEligibility[]
  requirements     SubmissionRequirement[]
  topics           Topic[]

  @@unique([semesterId, projectTypeId])
  @@unique([id, semesterId])
  @@map("registration_rounds")
}

/// Cohorts eligible to participate in a registration round
model RoundEligibility {
  id      Int    @id @default(autoincrement())
  roundId Int
  cohort  String // Intake year matching StudentProfile.cohort (e.g. "2022")

  round RegistrationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, cohort])
  @@map("round_eligibilities")
}

/// Individual student eligibility whitelist imported by academic assistant
model RoundStudentEligibility {
  id        Int      @id @default(autoincrement())
  roundId   Int
  studentId Int
  note      String?  // Academic eligibility note (e.g. "Credits fulfilled", "Fast track")
  createdAt DateTime @default(now())

  round   RegistrationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  student StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([roundId, studentId])
  @@index([roundId])
  @@index([studentId])
  @@map("round_student_eligibilities")
}

// Project category (e.g. "Đồ án cơ sở", "Đồ án chuyên ngành", "Khóa luận tốt nghiệp")
model ProjectType {
  id             Int                 @id @default(autoincrement())
  name           String
  code           String              @unique
  rounds         RegistrationRound[]
  topicProposals TopicProposal[]

  @@map("project_types")
}

// ─────────────────────────────────────────────────────────
// GROUP 3: TOPIC PROPOSALS (Student-initiated)
// ─────────────────────────────────────────────────────────

model TopicProposal {
  id                   Int                 @id @default(autoincrement())
  semesterId           Int
  studentId            Int
  projectTypeId        Int
  title                String
  description          String              @db.Text
  expectedOutcomes     String              @db.Text
  maxStudents          Int                 @default(1)
  requestedLecturerId  Int?                // Student-preferred supervising lecturer (optional)
  acceptedByLecturerId Int?                // Lecturer who accepted the proposal
  status               TopicProposalStatus @default(PENDING)
  lecturerFeedback     String?             @db.Text
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // Relations
  semester           Semester             @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  student            StudentProfile       @relation("ProposalStudent", fields: [studentId], references: [id], onDelete: Cascade)
  projectType        ProjectType          @relation(fields: [projectTypeId], references: [id], onDelete: Restrict)
  requestedLecturer  LecturerProfile?     @relation("ProposalRequestedLecturer", fields: [requestedLecturerId], references: [id], onDelete: SetNull)
  acceptedByLecturer LecturerProfile?     @relation("ProposalAcceptedLecturer", fields: [acceptedByLecturerId], references: [id], onDelete: SetNull)
  convertedTopic     Topic?
  attachments        ProposalAttachment[]
  comments           ProposalComment[]

  @@map("topic_proposals")
}

model ProposalAttachment {
  id           Int            @id @default(autoincrement())
  proposalId   Int
  fileUrl      String
  filePublicId String
  fileName     String
  fileSize     Int
  fileType     AttachmentType
  createdAt    DateTime       @default(now())

  proposal TopicProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("proposal_attachments")
}

model ProposalComment {
  id         Int                       @id @default(autoincrement())
  proposalId Int
  authorId   Int
  content    String                    @db.Text
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @default(now()) @updatedAt
  proposal   TopicProposal             @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  author     User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions  ProposalCommentReaction[]

  @@index([proposalId])
  @@index([authorId])
  @@map("proposal_comments")
}

model ProposalCommentReaction {
  id        Int             @id @default(autoincrement())
  commentId Int
  userId    Int
  createdAt DateTime        @default(now())
  comment   ProposalComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("proposal_comment_reactions")
}

// ─────────────────────────────────────────────────────────
// GROUP 4: TOPICS & REGISTRATION
// ─────────────────────────────────────────────────────────

model Topic {
  id                   Int                    @id @default(autoincrement())
  semesterId           Int
  lecturerId           Int
  majorId              Int?                   // Department: Software Engineering (CNPM) or Networks (MMT)
  roundId              Int                    // Registration round this topic belongs to
  sourceProposalId     Int?                   @unique // Set if topic originated from a student proposal
  title                String                 // Default display title
  titleVi              String?                // Vietnamese title
  titleEn              String?                // English title
  description          String                 @db.Text
  objectives           String?                @db.Text // Key objectives
  expectedOutcomes     String                 @db.Text // Expected deliverables
  techStack            String?                // Technology stack (e.g. React, NestJS, Docker)
  maxStudents          Int                    @default(3) // Maximum students per group (1 - 3)
  status               TopicStatus            @default(DRAFT)
  departmentReviewerId Int?                   // Department head reviewer for academic vetting
  departmentFeedback   String?                @db.Text
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  // Relations
  semester                Semester                @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  lecturer                LecturerProfile         @relation(fields: [lecturerId], references: [id], onDelete: Restrict)
  major                   Major?                  @relation(fields: [majorId], references: [id], onDelete: SetNull)
  departmentReviewer      LecturerProfile?        @relation("TopicDepartmentReviewer", fields: [departmentReviewerId], references: [id], onDelete: SetNull)
  round                   RegistrationRound       @relation(fields: [roundId, semesterId], references: [id, semesterId], onDelete: Restrict)
  sourceProposal          TopicProposal?          @relation(fields: [sourceProposalId], references: [id], onDelete: SetNull)
  registrationGroups      RegistrationGroup[]
  submissions             Submission[]
  councilTopic            CouncilTopic?
  outlines                TopicOutline[]
  archives                TopicArchive[]
  changeRequests          TopicChangeRequest[]
  similarityChecksSource  TopicSimilarityCheck[]  @relation("SourceTopicSimilarity")
  similarityChecksMatched TopicSimilarityCheck[]  @relation("MatchedTopicSimilarity")
  assignments             TopicAssignment[]

  @@unique([id, semesterId])
  @@index([roundId])
  @@map("topics")
}

model RegistrationGroup {
  id               Int                     @id @default(autoincrement())
  topicId          Int
  semesterId       Int
  leaderId         Int                     // Leader student profile ID
  name             String?
  status           RegistrationGroupStatus @default(FORMING)
  lecturerFeedback String?                 @db.Text
  openForJoin      Boolean                 @default(true) // Whether the group is open for additional members
  declaredSize     Int?                    // Target group size declared by leader (1 - 3)
  holdUntil        DateTime?               // Seat reservation expiration timestamp
  joinCode         String?                 @unique // Unique code for direct invitation link
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Relations
  topic           Topic                     @relation(fields: [topicId, semesterId], references: [id, semesterId], onDelete: Restrict)
  semester        Semester                  @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  leader          StudentProfile            @relation(fields: [leaderId], references: [id], onDelete: Restrict)
  members         RegistrationGroupMember[]
  submissions     Submission[]
  councilTopic    CouncilTopic?
  outline         TopicOutline?
  reviews         TopicReview[]
  archive         TopicArchive?
  changeRequests  TopicChangeRequest[]
  weeklyLogs      WeeklyLog[]
  progressReports ProgressReport[]
  assignment      TopicAssignment?
  studentGrades   StudentGrade[]

  @@unique([id, topicId])
  @@unique([id, semesterId])
  @@map("registration_groups")
}

model RegistrationGroupMember {
  id            Int               @id @default(autoincrement())
  groupId       Int
  semesterId    Int               // Denormalised from group for semester-level uniqueness
  studentId     Int
  status        GroupMemberStatus @default(ACCEPTED)
  joinSource    GroupJoinSource   @default(SELF)
  assignedById  Int?              // Admin user who assigned member during reconciliation
  assignedAt    DateTime?
  mentorGrade   Float?            // Individual grade from supervising lecturer
  mentorComment String?           @db.Text
  joinedAt      DateTime?         // Timestamp when member joined the group
  createdAt     DateTime          @default(now())

  // Relations
  group      RegistrationGroup @relation(fields: [groupId, semesterId], references: [id, semesterId], onDelete: Cascade)
  student    StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  assignedBy User?             @relation("GroupMemberAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([groupId, studentId])
  @@index([studentId, semesterId])
  @@map("registration_group_members")
}

// ─────────────────────────────────────────────────────────
// GROUP 5: SUBMISSIONS
// ─────────────────────────────────────────────────────────

/// Deliverable requirement configured by faculty office for a round
model SubmissionRequirement {
  id          Int               @id @default(autoincrement())
  roundId     Int
  name        String            // Deliverable name (e.g. "Outline", "Report", "Source code")
  dueAt       DateTime          // Submission deadline
  isRequired  Boolean           @default(true) // Required or optional deliverable
  sortOrder   Int               @default(0)    // Display and sequence order
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  round       RegistrationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([roundId, name])
  @@index([roundId, sortOrder])
  @@map("submission_requirements")
}

model Submission {
  id               Int                   @id @default(autoincrement())
  topicId          Int
  groupId          Int
  requirementId    Int                   // FK to SubmissionRequirement
  fileUrl          String?               // Stored file download URL
  filePublicId     String?               // Storage file public handle
  fileName         String?               // Original uploaded file name
  fileSize         Int?                  // File size in bytes
  submissionUrl    String?               // External repository or drive URL
  version          Int                   @default(1) // Incremented on resubmission
  submittedById    Int?                  // Student profile ID of submitter
  lecturerFeedback String?               @db.Text
  feedbackAt       DateTime?             // Timestamp when supervisor answered
  submittedAt      DateTime              @default(now())

  // Relations
  topic       Topic                 @relation(fields: [topicId], references: [id], onDelete: Restrict)
  group       RegistrationGroup     @relation(fields: [groupId, topicId], references: [id, topicId], onDelete: Cascade)
  requirement SubmissionRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  submittedBy StudentProfile?       @relation("SubmissionAuthor", fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([topicId])
  @@index([groupId, requirementId, version])
  @@map("submissions")
}

// ─────────────────────────────────────────────────────────
// GROUP 6: DEFENSE COUNCILS
// ─────────────────────────────────────────────────────────

model Council {
  id          Int             @id @default(autoincrement())
  semesterId  Int
  majorId     Int?
  name        String
  location    String?
  defenseDate DateTime
  status      String          @default("PREP") // PREP | IN_PROGRESS | COMPLETED
  createdAt   DateTime        @default(now())

  // Relations
  semester Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  major    Major?          @relation(fields: [majorId], references: [id], onDelete: SetNull)
  members  CouncilMember[]
  topics   CouncilTopic[]

  @@map("councils")
}

model CouncilMember {
  id          Int               @id @default(autoincrement())
  councilId   Int
  lecturerId  Int
  councilRole CouncilMemberRole

  // Relations
  council  Council         @relation(fields: [councilId], references: [id], onDelete: Cascade)
  lecturer LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Restrict)

  @@unique([councilId, lecturerId])
  @@map("council_members")
}

model CouncilTopic {
  id           Int                 @id @default(autoincrement())
  councilId    Int
  topicId      Int                 @unique // Each topic defended in exactly one council session
  groupId      Int                 @unique // Each group defends in exactly one council session
  reviewerId   Int                 // Assigned academic reviewer
  timeSlot     String?
  defenseOrder Int                 @default(1)
  status       String              @default("SCHEDULED") // SCHEDULED | DEFENDING | COMPLETED
  evaluations  Json?               // Panel evaluations: [{ lecturerId, lecturerName, role, score, feedback, submittedAt }]
  minuteNotes  String?             @db.Text
  isLocked     Boolean             @default(false)

  // Relations
  council  Council           @relation(fields: [councilId], references: [id], onDelete: Cascade)
  topic    Topic             @relation(fields: [topicId], references: [id], onDelete: Restrict)
  group    RegistrationGroup @relation(fields: [groupId, topicId], references: [id, topicId], onDelete: Restrict)
  reviewer LecturerProfile   @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  grades   CouncilTopicGrade[]

  @@unique([groupId, topicId])
  @@map("council_topics")
}

model CouncilTopicGrade {
  id             Int            @id @default(autoincrement())
  councilTopicId Int
  studentId      Int
  councilGrade   Float?         // Grade from the full defense council panel
  reviewerGrade  Float?         // Grade from the assigned reviewer
  finalGrade     Float?         // Final weighted grade, frozen at deadline
  finalisedAt    DateTime?

  // Relations
  councilTopic CouncilTopic   @relation(fields: [councilTopicId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([councilTopicId, studentId])
  @@map("council_topic_grades")
}

// ─────────────────────────────────────────────────────────
// GROUP 7: NOTIFICATIONS
// ─────────────────────────────────────────────────────────

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  content   String           @db.Text
  targetId  Int?             // Target entity ID for client routing
  isRead    Boolean          @default(false)
  dedupeKey String?          @unique // Idempotency deduplication key for scheduled alerts
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────
// GROUP 8: AUDIT LOGS
// ─────────────────────────────────────────────────────────

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String   // e.g. UPDATE_GRADE, DELETE_TOPIC, LOCK_ACCOUNT
  targetTable String   // Table name affected
  targetId    String   // Stringified PK of affected record
  oldValue    Json?    // Snapshot before change
  newValue    Json?    // Snapshot after change
  createdAt   DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────
// GROUP 9: REFRESH TOKENS & RESET TOKENS
// ─────────────────────────────────────────────────────────

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique // SHA-256 hash of refresh token
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

/// One-time password reset tokens (SHA-256 hashed)
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique // SHA-256 hash of reset token
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────
// GROUP 10: DLU FORMS & ADMINISTRATIVE WORKFLOWS (M03, M02/M05, ARCHIVE)
// ─────────────────────────────────────────────────────────

/// Detailed project outline (Form M03) submission and review workflow
model TopicOutline {
  id               Int       @id @default(autoincrement())
  groupId          Int       @unique
  topicId          Int
  attachmentUrl    String?   // Signed scanned copy file URL
  fileName         String?   // Original file name (e.g. M03_De_cuong.pdf)
  fileSize         Int?      // File size in bytes
  publicId         String?   // Storage handle for file deletion
  submittedById    Int?      // Submitter user ID
  submittedAt      DateTime? // Submission timestamp
  status           String    @default("NOT_SUBMITTED") // NOT_SUBMITTED | SUBMITTED | NEEDS_REVISION | APPROVED_BY_LECTURER
  lecturerFeedback String?   @db.Text
  approvedAt       DateTime?
  objectives       String?   @db.Text
  scopeAndContent  String?   @db.Text
  toolsAndTech     String?   @db.Text
  expectedResults  String?   @db.Text
  weeklyPlans      Json?     // Weekly schedule: [{ week, fromDate, toDate, task, deliverable }]
  references       String?   @db.Text
  pdfExportUrl     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  group       RegistrationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  topic       Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  submittedBy User?             @relation("OutlineSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  @@map("topic_outlines")
}

/// Official review forms: Form M02/M04 (Supervisor) and Form M05 (Reviewer)
model TopicReview {
  id                 Int               @id @default(autoincrement())
  groupId            Int
  lecturerId         Int
  reviewerType       String            // "SUPERVISOR" | "REVIEWER"
  templateCode       String            // "M02" (Project Supervisor) | "M04" (Thesis Supervisor) | "M05" (Reviewer)
  evaluationCriteria Json?             // Rubric evaluation scores and criteria
  generalComment     String            @db.Text
  isDefenseAllowed   Boolean           @default(true) // Permission to proceed to defense
  pdfExportUrl       String?
  signedAt           DateTime          @default(now())

  group    RegistrationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lecturer LecturerProfile   @relation(fields: [lecturerId], references: [id], onDelete: Restrict)

  @@unique([groupId, reviewerType])
  @@map("topic_reviews")
}

/// Digital archive package (Source code, Database script, Final thesis report)
model TopicArchive {
  id                     Int               @id @default(autoincrement())
  groupId                Int               @unique
  topicId                Int
  sourceUrl              String            // SOURCE folder: complete source code and configuration
  databaseUrl            String            // DATABASE folder: DDL scripts and sample database dump
  thesisUrl              String            // THESIS folder: final PDF report including signed M03 and M02/M05
  abstractVi             String?           @db.Text
  abstractEn             String?           @db.Text
  keywords               String?
  isVerifiedBySupervisor Boolean           @default(false) // Supervisor verification flag
  isVerifiedByAcademic   Boolean           @default(false) // Academic assistant verification flag
  archivedAt             DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  group RegistrationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  topic Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("topic_archives")
}

/// Change requests during project execution (Title change, Member adjustment, Deadline extension)
model TopicChangeRequest {
  id                Int               @id @default(autoincrement())
  groupId           Int
  topicId           Int
  requestType       String            // "CHANGE_TITLE" | "CHANGE_MEMBER" | "EXTEND_DEADLINE" | "CANCEL_TOPIC"
  reason            String            @db.Text
  oldValue          String?           @db.Text
  newValue          String?           @db.Text
  status            String            @default("PENDING") // PENDING | APPROVED | REJECTED
  supervisorComment String?           @db.Text
  facultyComment    String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  group RegistrationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  topic Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("topic_change_requests")
}

// ─────────────────────────────────────────────────────────
// GROUP 11: PROGRESS, REVIEWS, GRADING & SIMILARITY CHECKS
// ─────────────────────────────────────────────────────────

/// Topic similarity checks for plagiarism prevention
model TopicSimilarityCheck {
  id              Int      @id @default(autoincrement())
  topicId         Int
  matchedTopicId  Int
  similarityScore Float    // Similarity ratio (0.00 – 1.00)
  matchedFields   Json?    // Detailed matched fields
  createdAt       DateTime @default(now())

  topic        Topic @relation("SourceTopicSimilarity", fields: [topicId], references: [id], onDelete: Cascade)
  matchedTopic Topic @relation("MatchedTopicSimilarity", fields: [matchedTopicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("topic_similarity_checks")
}

/// Weekly task tracking and communication logs between students and supervisor
model WeeklyLog {
  id                   Int               @id @default(autoincrement())
  groupId              Int
  weekNumber           Int               // Week index (1 - 15)
  title                String?           // Milestone or task title
  completionPercentage Int               @default(0) // Completion progress (0 - 100%)
  gitCommitUrl         String?           // Source code commit URL for verification
  summaryNotes         String            @db.Text // Work completed during the week
  blockers             String?           @db.Text // Difficulties and obstacles
  submittedById        Int?
  lecturerComment      String?           @db.Text // Supervisor comment and feedback
  isAcknowledged       Boolean           @default(false) // Supervisor viewed acknowledgment
  feedbackAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  group       RegistrationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  submittedBy User?             @relation("WeeklyLogSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([groupId, weekNumber])
  @@map("weekly_logs")
}

/// Milestone progress reports: Stage 1 (20%) and Stage 2 (30%)
model ProgressReport {
  id                 Int               @id @default(autoincrement())
  groupId            Int
  stage              String            // "STAGE_1" (Progress 1 - 20%) | "STAGE_2" (Progress 2 - 30%)
  reportFileUrl      String?           // Report file URL (.pdf / .docx)
  reportFileName     String?           // Original file name
  reportFileSize     Int?              // File size in bytes
  sourceCodeUrl      String?           // Source repository link
  submittedById      Int?
  submittedAt        DateTime          @default(now())
  supervisorGrade    Float?            // Supervisor evaluation score (scale 0-10)
  supervisorFeedback String?           @db.Text
  reviewerGrade      Float?            // Reviewer evaluation score (Stage 2, scale 0-10)
  reviewerFeedback   String?           @db.Text
  finalStageGrade    Float?            // Final stage grade (Stage 1 = Supervisor; Stage 2 = Average)
  workloadPercentage Int?              // Evaluated workload completion percentage (0 - 100%)
  isPassed           Boolean?          // Permission to continue / proceed to defense
  finalisedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  group       RegistrationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  submittedBy User?             @relation("ProgressReportSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  @@unique([groupId, stage])
  @@map("progress_reports")
}

/// Academic reviewer assignment before Stage 2
model TopicAssignment {
  id           Int             @id @default(autoincrement())
  groupId      Int             @unique
  topicId      Int
  supervisorId Int
  reviewerId   Int             // Academic reviewer (same department, different from supervisor)
  assignedById Int             // Department head or academic assistant who assigned reviewer
  assignedAt   DateTime        @default(now())

  group      RegistrationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  topic      Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  supervisor LecturerProfile   @relation("TopicAssignmentSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  reviewer   LecturerProfile   @relation("TopicAssignmentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  assignedBy User              @relation("TopicAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@map("topic_assignments")
}

/// Official final student grade transcript based on the standard DLU formula:
/// Final Grade = (20% * Progress1) + (30% * Progress2) + (50% * Defense)
model StudentGrade {
  id               Int               @id @default(autoincrement())
  groupId          Int
  studentId        Int
  progress1Grade   Float?            // Progress 1 score (20% - Supervisor)
  progress2Grade   Float?            // Progress 2 score (30% - Supervisor + Reviewer)
  defenseGrade     Float?            // Council defense score (50%)
  finalGradeNum    Float?            // Final 10-point scale grade
  finalGradeLetter String?           // Letter grade (A, B+, B, C+, C, D+, D, F)
  note             String?           @db.Text
  isLocked         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  group   RegistrationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([groupId, studentId])
  @@map("student_grades")
}
